# Conditional Statements in Python — Notes
# What are Conditional Statements?

# Conditional statements are used to make decisions in Python programs.

# They execute different blocks of code based on whether a condition is:

# True
# False
# Types of Conditional Statements
# 1. if Statement

# Used to execute code only when a condition is true.

# Syntax
# if condition:
#     statement
# Example
# age = 18

# if age >= 18:
#     print("Eligible to vote")
# 2. if-else Statement

# Used when there are two possible outcomes.

# Syntax
# if condition:
#     statement
# else:
#     statement
# Example
# number = 5

# if number % 2 == 0:
#     print("Even")
# else:
#     print("Odd")
# 3. if-elif-else Statement

# Used to check multiple conditions.

# Syntax
# if condition:
#     statement
# elif condition:
#     statement
# else:
#     statement
# Example
# marks = 85

# if marks >= 90:
#     print("Grade A")
# elif marks >= 70:
#     print("Grade B")
# elif marks >= 50:
#     print("Grade C")
# else:
#     print("Fail")
# 4. match-case Statement

# Introduced in Python 3.10.

# Used for pattern matching.

# Syntax
# match variable:
#     case value:
#         statement
# Example
# day = 2

# match day:
#     case 1:
#         print("Monday")
#     case 2:
#         print("Tuesday")
#     case 3:
#         print("Wednesday")
#     case _:
#         print("Invalid Day")
# Comparison Operators
# Operator	Meaning
# ==	Equal to
# !=	Not equal to
# >	Greater than
# <	Less than
# >=	Greater than or equal
# <=	Less than or equal
# Logical Operators
# Operator	Meaning
# and	Both conditions must be true
# or	At least one condition must be true
# not	Reverses the condition
# Example
# age = 25

# if age >= 18 and age <= 60:
#     print("Working Age")
# Important Points
# Indentation is important in Python.
# Conditions return either True or False.
# elif means “else if”.
# match-case works like switch statements in other languages.
# Short Summary
# Statement	Purpose
# if	Checks one condition
# if-else	Checks two outcomes
# if-elif-else	Checks multiple conditions
# match-case	Pattern matching




# What are Loops?

# Loops are used to execute a block of code repeatedly.

# Types of Loops in Python
# 1. for Loop

# Used when the number of iterations is known.

# Syntax
# for variable in sequence:
#     # code
# Example
# for i in range(5):
#     print(i)
# Output
# 0
# 1
# 2
# 3
# 4
# 2. while Loop

# Used when repetition depends on a condition.

# Syntax
# while condition:
#     # code
# Example
# i = 1

# while i <= 5:
#     print(i)
#     i += 1
# Output
# 1
# 2
# 3
# 4
# 5
# range() Function

# Used to generate a sequence of numbers.

# Example
# range(5)

# Produces:

# 0, 1, 2, 3, 4
# Increment in Python

# Python does NOT support:

# ❌ Invalid

# i++

# ✅ Correct

# i += 1
# Common Errors
# ❌ Invalid
# for i in i++:

# Reason:

# i++ is not supported in Python.
# ❌ Invalid
# for i in i += 1:

# Reason:

# i += 1 is not an iterable.
